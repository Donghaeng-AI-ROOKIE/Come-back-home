# API 키 발급 후 .env 로 복사해서 채우기 — 비어 있으면 모든 모델이 스텁 모드로 동작
# ⚠️ 주석은 반드시 별도 줄에: `KEY=값  # 주석` 처럼 줄 끝에 달면 주석까지 값으로 읽힘

# KT 믿음(Mi:dm) — Phase 0 온보딩, 2.5 API 연결 규약 포함 (제보 Mini와 별도)
#   MIDM_API_KEY  = API Key (Bearer)
#   MIDM_BASE_URL = endpoint URL (…/v1 또는 …/v1/chat/completions)
#   MIDM_MODEL    = 모델/endpoint ID (chat 요청 model 필드)
#   결선(2026-09) KT 직접 발급본: BASE_URL=https://midm.kt.com/v1, MODEL 은 안내문에 없고
#   운영진이 따로 알려준 ID 를 넣는다. 안내문 endpoint 에 `comletions` 오타가 있었으니
#   그대로 붙여넣지 말 것. 연결 확인은 scripts/probe_midm_models.py <모델ID>.
MIDM_API_KEY=
MIDM_BASE_URL=
MIDM_MODEL=

# 한국어 문장 임베더 — Phase 0 히스토리-어웨어 슬롯 검색 (없으면 해시 스텁 폴백)
#   EMBED_BASE_URL = …/v1 또는 …/v1/embeddings (현재 Upstage: https://api.upstage.ai/v1)
#   EMBED_MODEL    = 질문용 모델 (예: embedding-query)
#   EMBED_MODEL_PASSAGE = 문서용 모델 (예: embedding-passage, 비우면 EMBED_MODEL과 동일)
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_MODEL_PASSAGE=
EMBED_API_KEY=

# Phase 2 RAG 인덱스 경로 — 임베더 바꾸면 인덱스도 그 임베더로 재생성해야 한다
#   (차원이 다르면 검색 시 에러). experiments/embedder_swap/build_index.py 로 생성.
#   빈 값(RAG_INDEX_PATH=)도 값으로 읽혀 RAG 가 꺼진다 — 쓰지 않을 거면 줄을 지운다.
RAG_INDEX_PATH=data/rag_index_upstage.npz

# LG EXAONE — Phase 2 prior 생성·마음 예측 (OpenAI 호환 chat completions)
#   EXAONE_API_KEY  = API Key (Bearer)
#   EXAONE_BASE_URL = endpoint URL (…/v1 또는 …/v1/chat/completions)
#   EXAONE_MODEL    = endpoint ID (chat 요청 model 필드)
EXAONE_API_KEY=
EXAONE_BASE_URL=
EXAONE_MODEL=

# legacy/fallback 마음 재해석 전용. 준비된 정상 K 정책은 보행 중 코드로 실행.
#   MIND_MODEL    = vLLM lora 모듈명 (코드 기본값: exaone-mind-dem5)
#   MIND_CONTRACT = v2(1인칭 행동 계약+guided, 기본) | v1(분석가형 롤백)
MIND_MODEL=exaone-mind-dem5
MIND_CONTRACT=v2

# Phase 3 제보 구조화 전용 — Mi:dm 2.0 Mini. 온보딩 Mi:dm과 별도 라우팅.
# 미설정 개발 모드는 스텁. 설정된 호출 실패는 판정 없음으로 처리한다.
#   TIP_LLM_API_KEY  = API Key (Bearer)
#   TIP_LLM_BASE_URL = endpoint URL (…/v1 또는 …/v1/chat/completions)
#   TIP_LLM_MODEL    = endpoint ID (chat 요청 model 필드)
TIP_LLM_API_KEY=
TIP_LLM_BASE_URL=
TIP_LLM_MODEL=

# 안내 문구: 비우면 TIP_LLM_*의 Mini 설정 상속. 초안 문장만 다듬는다.
COPY_LLM_API_KEY=
COPY_LLM_BASE_URL=
COPY_LLM_MODEL=

# 튜닝 파라미터 (기본값은 app/config.py 참고)
# H3_RESOLUTION=9
# MC_NUM_WALKERS=500
# TIP_DISCARD_THRESHOLD=0.2
# TIP_LKP_THRESHOLD=0.8
# LAYER2_PERIODIC_MINUTES=45
# KL_DIVERGENCE_THRESHOLD=0.5

# 전체 축 채점은 기본 OFF. 아래 true는 선택적 기존 경로의 예시이며 현재 확정값 아님.
# ON으로 바꿀 때는 AXIS_SCORING_MODEL을 Base ID로 별도 지정해야 한다.
# OFF도 SAR prior·K 이동 능력 보정·개인 행동 규칙은 계속 적용한다.
#   AXIS_SCORING_ENABLED=true
#   AXIS_SCORING_MODEL=exaone-base
#   AXIS_SCORING_RUNS=3
#   AXIS_RUBRIC_PATH=app/phase0/axis_rubric.md

# Phase 2 도로망 시뮬레이션 — 켜면 직선거리 대신 도로망 최단경로 사용
# (제보 신뢰도 p 의 시공간 개연성 계산 포함). 캐시 없는 좌표는 첫 로딩 시
# Overpass 라이브 다운로드(수십 초) 발생 — 테스트는 conftest.py 가 항상 오프.
#   USE_ROADNET=true

# K 사전 개인 해석·재검토 (초기 interpret는 최대4회, 자동 재시도 없음).
# 등록 뒤 준비해 저장하고 신고 시 SAR prior에 코드로 보정 적용한다.
# 준비 실패·미설정은 상태로 남긴다. 제공받은 API 설정을 입력.
KEXAONE_API_KEY=
KEXAONE_BASE_URL=
KEXAONE_MODEL=
KEXAONE_TIMEOUT=420
RESEARCH_USAGE_LEDGER_PATH=data/research_usage_events.jsonl

# Independent literature distance map / sourced personal mind walk.
# Validated personal-following + departing routes, not contrary-only selection.
# PERSONAL_CHANNEL_WEIGHT=0.3  # minimum permitted: 0.3
# STATISTICAL_CHANNEL_DEFINITION=literature_distance_prior
# Registration, alert lookup and entry negotiate this resolution with the server.
# Legacy res7 clients use geographic overlap; external push receipt is unmeasured.
# PUSH_TARGET_RES=9
# ALERT_COVERAGE=0.95

# PERSONAL_FIRST_ALERT_COST_20261012: frozen choice, new 351-route confirmation.
# Same-area stat-only ablation confirms personal-following benefit; contrary
# inclusion remains limited. Full evidence: docs/experiments/personal-first-alert-balanced-20261012.
# ALERT_SELECTION_POLICY=area_budget
# MAX_ALERT_AREA_KM2=5.8
# The cap charges the actual geographic delivery cover, including res8 expansion.
# Area mode has no 95% coverage guarantee; /targeting-policy returns coverage=null.
