# API 키 발급 후 .env 로 복사해서 채우기 — 비어 있으면 모든 모델이 스텁 모드로 동작
# ⚠️ 주석은 반드시 별도 줄에: `KEY=값  # 주석` 처럼 줄 끝에 달면 주석까지 값으로 읽힘

# KT 믿음(Mi:dm) — Phase 0 온보딩 챗봇 (OpenAI 호환 chat completions)
#   MIDM_API_KEY  = API Key (Bearer)
#   MIDM_BASE_URL = endpoint URL (…/v1 또는 …/v1/chat/completions)
#   MIDM_MODEL    = endpoint ID (chat 요청 model 필드)
MIDM_API_KEY=
MIDM_BASE_URL=
MIDM_MODEL=

# 한국어 문장 임베더 — Phase 0 히스토리-어웨어 슬롯 검색 (없으면 해시 스텁 폴백)
#   EMBED_BASE_URL = …/v1 또는 …/v1/embeddings (현재 Upstage: https://api.upstage.ai/v1)
#   EMBED_MODEL    = 질문용 모델 (예: embedding-query)
#   EMBED_MODEL_PASSAGE = 문서용 모델 (예: embedding-passage, 비우면 EMBED_MODEL과 동일)
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_MODEL_PASSAGE=
EMBED_API_KEY=

# Phase 2 RAG 인덱스 경로 — 임베더 바꾸면 인덱스도 그 임베더로 재생성해야 한다
#   (차원이 다르면 검색 시 에러). experiments/embedder_swap/build_index.py 로 생성.
RAG_INDEX_PATH=

# LG EXAONE — Phase 2 prior 생성·마음 예측 (OpenAI 호환 chat completions)
#   EXAONE_API_KEY  = API Key (Bearer)
#   EXAONE_BASE_URL = endpoint URL (…/v1 또는 …/v1/chat/completions)
#   EXAONE_MODEL    = endpoint ID (chat 요청 model 필드)
EXAONE_API_KEY=
EXAONE_BASE_URL=
EXAONE_MODEL=

# 마음 재해석 전용 (2026-08-04 치매 단독 재학습본으로 교체)
#   MIND_MODEL    = vLLM lora 모듈명 (확정: exaone-mind-dem3, 비우면 EXAONE_MODEL)
#   MIND_CONTRACT = v2(1인칭 행동 계약+guided, 기본) | v1(분석가형 롤백)
MIND_MODEL=exaone-mind-dem3
MIND_CONTRACT=v2

# Phase 3 제보 구조화 전용 — 모델 미정(2026-07-21, Mi:dm 에서 분리). 비어 있으면
# 스텁(키워드 휴리스틱)으로 동작. OpenAI 호환 chat completions 모델이면 그대로 연결.
#   TIP_LLM_API_KEY  = API Key (Bearer)
#   TIP_LLM_BASE_URL = endpoint URL (…/v1 또는 …/v1/chat/completions)
#   TIP_LLM_MODEL    = endpoint ID (chat 요청 model 필드)
TIP_LLM_API_KEY=
TIP_LLM_BASE_URL=
TIP_LLM_MODEL=

# 기타 모델(추후)
VARCO_API_KEY=
UPSTAGE_API_KEY=

# 튜닝 파라미터 (기본값은 app/config.py 참고)
# H3_RESOLUTION=9
# MC_NUM_WALKERS=500
# TIP_DISCARD_THRESHOLD=0.2
# TIP_LKP_THRESHOLD=0.8
# LAYER2_PERIODIC_MINUTES=45
# KL_DIVERGENCE_THRESHOLD=0.5

# Phase 0 축 점수 컴파일 — 인터뷰 종료 시 axis_evidence를 EXAONE(B x P1)으로 채점
# 켜면 등록 1건당 EXAONE 18회(치매 6축 x 3회) 호출, 등록 확인 응답 약 1분 지연
#   AXIS_SCORING_ENABLED=true
#   AXIS_SCORING_RUNS=3
#   AXIS_RUBRIC_PATH=app/phase0/axis_rubric.md
