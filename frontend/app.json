{
  "expo": {
    "name": "돌아오길",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "산책과 주변 수색 알림에는 넓은 구역만 사용하며 이동 경로는 저장하지 않아요. 보호자가 신고 화면에서 현재 위치 사용을 선택한 경우에만 그 좌표를 마지막 목격 장소로 전송해요.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.donghaeng.comebackhome"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.donghaeng.comebackhome",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "산책과 주변 수색 알림에는 넓은 구역만 사용하며 이동 경로는 저장하지 않아요. 보호자가 신고 화면에서 현재 위치 사용을 선택한 경우에만 그 좌표를 마지막 목격 장소로 전송해요."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D62839"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0fcff5c0-7aa5-46a5-83ee-646389410931"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0fcff5c0-7aa5-46a5-83ee-646389410931"
    }
  }
}
