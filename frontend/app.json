{
  "expo": {
    "name": "돌아오길",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "산책 거리를 재고, 내가 실종자 예측 구역 안에 있을 때 알려드리기 위해 위치를 사용해요. 정확한 위치는 기기 밖으로 나가지 않아요. 알림을 보내는 데 필요한 약 5km 범위의 넓은 구역 하나만 서버에 전달하고, 이동 경로는 저장하지 않아요."
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "package": "com.donghaeng.comebackhome",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "산책 거리를 재고, 내가 실종자 예측 구역 안에 있을 때 알려드리기 위해 위치를 사용해요. 정확한 위치는 기기 밖으로 나가지 않아요. 알림을 보내는 데 필요한 약 5km 범위의 넓은 구역 하나만 서버에 전달하고, 이동 경로는 저장하지 않아요."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D62839"
        }
      ],
      "expo-font"
    ]
  }
}
